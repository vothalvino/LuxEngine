<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Wider dialogs for the fixture browser and output settings -->
    <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
    <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>

    <SolidColorBrush x:Key="LuxAccentBrush" Color="#FFFFB938" />
    <SolidColorBrush x:Key="LuxDangerBrush" Color="#FFE5484D" />
    <SolidColorBrush x:Key="LuxOkBrush" Color="#FF3DD68C" />
    <SolidColorBrush x:Key="LuxStageBrush" Color="#FF101018" />

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="PanelHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <Style x:Key="SwatchButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
</ResourceDictionary>
