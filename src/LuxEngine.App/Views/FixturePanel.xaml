<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LuxEngine.App.Views.FixturePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LuxEngine.App.Views">

    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="4,0,0,0">
            <TextBlock x:Name="Header" Text="FIXTURES" Style="{StaticResource PanelHeaderStyle}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                <Button Style="{StaticResource IconButtonStyle}" Click="SelectAll_Click" ToolTipService.ToolTip="Select all">
                    <FontIcon Glyph="&#xE8B3;" FontSize="16" />
                </Button>
                <Button Padding="10,6" Click="Add_Click" ToolTipService.ToolTip="Add lights from the fixture library">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1" x:Name="ConflictBar" Severity="Warning" IsClosable="False" IsOpen="False"
                 Title="Address overlap" />

        <Grid Grid.Row="2">
            <ListView x:Name="FixtureList" ItemsSource="{x:Bind Rows}" SelectionMode="Extended"
                      SelectionChanged="List_SelectionChanged" RightTapped="List_RightTapped"
                      DoubleTapped="List_DoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:FixtureRow">
                        <Grid ColumnSpacing="10" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="12" Height="12" Fill="{x:Bind ColorBrush, Mode=OneWay}"
                                     Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Model}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind Address, Mode=OneWay}" FontFamily="Consolas"
                                       Foreground="{x:Bind AddressBrush, Mode=OneWay}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Padding="16">
                <FontIcon Glyph="&#xEA80;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="No lights yet" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Add your lights from the built-in library of hundreds of fixtures."
                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="Add fixtures" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="Add_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
