<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LuxEngine.App.Views.CueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LuxEngine.App.Views">

    <Grid Padding="12,10,12,12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="320" />
            <ColumnDefinition Width="2*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- Cue list with playback buttons -->
        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <Button x:Name="GoButton" Click="Go_Click" AutomationProperties.Name="GO" Style="{StaticResource AccentButtonStyle}" Padding="26,10"
                        ToolTipService.ToolTip="Start the next cue (Space)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" />
                        <TextBlock Text="GO" FontWeight="Bold" FontSize="16" />
                    </StackPanel>
                </Button>
                <Button Click="Back_Click" Padding="14,10" ToolTipService.ToolTip="Previous cue (Shift+Space)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE892;" FontSize="14" />
                        <TextBlock Text="Back" />
                    </StackPanel>
                </Button>
                <Button x:Name="PauseButton" Click="Pause_Click" Padding="14,10" ToolTipService.ToolTip="Pause or resume the fade">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="14" />
                        <TextBlock x:Name="PauseText" Text="Pause" />
                    </StackPanel>
                </Button>
                <Button Click="Release_Click" Padding="14,10" ToolTipService.ToolTip="Fade out everything the cues turned on">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                        <TextBlock Text="Release" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="FadeProgress" Minimum="0" Maximum="1" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Click="AddCue_Click" Padding="10,4" ToolTipService.ToolTip="Add a cue after the selected one">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                            <TextBlock Text="Cue" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Click="MoveUp_Click" ToolTipService.ToolTip="Move up">
                        <FontIcon Glyph="&#xE70E;" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Click="MoveDown_Click" ToolTipService.ToolTip="Move down">
                        <FontIcon Glyph="&#xE70D;" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Click="DeleteCue_Click" ToolTipService.ToolTip="Delete cue">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                    </Button>
                    <ToggleButton x:Name="LoopToggle" Click="Loop_Click" Padding="8,6" ToolTipService.ToolTip="After the last cue, start again at the first">
                        <FontIcon Glyph="&#xE8EE;" FontSize="13" />
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <ListView x:Name="CueListView" ItemsSource="{x:Bind Cues}" SelectionMode="Single"
                          SelectionChanged="CueList_SelectionChanged" DoubleTapped="CueList_DoubleTapped"
                          AllowDrop="True" DragOver="PresetDrop_DragOver" Drop="CueList_Drop">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:CueRow">
                            <Grid ColumnSpacing="12" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{StaticResource LuxAccentBrush}"
                                          Visibility="{x:Bind ActiveVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Number, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Presets, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{x:Bind Timing, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyCues" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="No cues yet" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Click &quot;+ Cue&quot;, then drag presets from the left onto it." HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Selected cue editor -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <Grid x:Name="Editor" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" x:Name="CueName" Header="Cue name" TextChanged="CueName_TextChanged" />

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <NumberBox x:Name="FadeInBox" Header="Fade in (s)" Minimum="0" Maximum="600" SmallChange="0.5"
                               SpinButtonPlacementMode="Compact" ValueChanged="Timing_ValueChanged" />
                    <NumberBox Grid.Column="1" x:Name="FadeOutBox" Header="Fade out (s)" Minimum="0" Maximum="600" SmallChange="0.5"
                               SpinButtonPlacementMode="Compact" ValueChanged="Timing_ValueChanged" />
                    <NumberBox Grid.Column="2" x:Name="DelayBox" Header="Delay (s)" Minimum="0" Maximum="600" SmallChange="0.5"
                               SpinButtonPlacementMode="Compact" ValueChanged="Timing_ValueChanged" />
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                    <ToggleSwitch x:Name="FollowSwitch" OnContent="Auto-follow on" OffContent="Auto-follow off" Toggled="Follow_Toggled" />
                    <NumberBox x:Name="FollowDelayBox" Header="" PlaceholderText="Wait (s)" Minimum="0" Maximum="3600" Width="110"
                               SpinButtonPlacementMode="Compact" ValueChanged="Timing_ValueChanged" VerticalAlignment="Bottom"
                               ToolTipService.ToolTip="Seconds to wait after the fade before the next cue starts" />
                </StackPanel>

                <Grid Grid.Row="3" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Presets in this cue" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <ListView x:Name="PresetList" ItemsSource="{x:Bind CuePresets}" SelectionMode="Single"
                                      CanReorderItems="True" AllowDrop="True" DragOver="PresetDrop_DragOver" Drop="PresetList_Drop"
                                      DragItemsCompleted="PresetList_DragItemsCompleted">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:CuePresetRow">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" Fill="{x:Bind ColorBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2" Tag="{x:Bind PresetId}" Click="RemovePreset_Click"
                                                    Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Remove from cue">
                                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="DropHint" Text="Drag presets here" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </Grid>

                <Button Grid.Row="4" x:Name="AddSelectedPresetButton" Click="AddSelectedPreset_Click" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock x:Name="AddSelectedPresetText" Text="Add the selected preset" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <TextBlock Grid.Column="1" x:Name="NoCueSelected" Text="Select a cue to edit it." VerticalAlignment="Center"
                   HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
    </Grid>
</UserControl>
