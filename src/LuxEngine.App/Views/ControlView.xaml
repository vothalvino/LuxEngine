<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LuxEngine.App.Views.ControlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:LuxEngine.App.Helpers"
    xmlns:views="using:LuxEngine.App.Views">

    <Grid RowSpacing="8" Padding="12,10,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Shown while a preset is being edited -->
        <Border Grid.Row="0" x:Name="PresetEditBar" Visibility="Collapsed" CornerRadius="8" Padding="12,8"
                Background="{ThemeResource LuxAttentionBrush}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="{ThemeResource LuxAttentionTextBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PresetEditTitle" Foreground="{ThemeResource LuxAttentionTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PresetEditInfo" Foreground="{ThemeResource LuxAttentionTextBrush}" Opacity="0.85" TextTrimming="CharacterEllipsis"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Click="PresetEditCancel_Click" Content="Cancel" />
                    <Button Click="PresetEditSave_Click" AutomationProperties.Name="Save preset changes">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock Text="Save changes" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Selection summary and actions -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="Clear_Click" ToolTipService.ToolTip="Forget all manual changes and go back to what the cues are doing">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE894;" FontSize="14" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>
                <Button x:Name="SavePresetButton" Click="SavePreset_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="Save as preset" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Cards wrap onto new rows instead of running off the side; scroll down for more -->
        <ScrollViewer Grid.Row="2" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
            <helpers:WrapPanel x:Name="Cards" HorizontalSpacing="10" VerticalSpacing="10">

                <!-- Every value in the preset being edited (built in code) -->
                <Border Style="{StaticResource CardStyle}" x:Name="PresetValuesCard" Width="400" Visibility="Collapsed"
                        BorderBrush="{ThemeResource LuxAttentionBrush}" BorderThickness="2">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <StackPanel Style="{StaticResource CardHeaderStyle}"><FontIcon Glyph="&#xE70F;" Style="{StaticResource CardIconStyle}" /><TextBlock Text="In this preset" Style="{StaticResource SectionTitleStyle}" /></StackPanel>
                            <TextBlock Text="Exact values of every light. Drag a slider or type a number (0–255). Click a light's name to select it for the other controls."
                                       TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PresetValueRows" Spacing="2" Padding="0,0,12,0" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Dimmer -->
                <Border Style="{StaticResource CardStyle}" Width="132">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Style="{StaticResource CardHeaderStyle}" ToolTipService.ToolTip="Keyboard: Shift+D, then ↑↓ or type a number"><FontIcon Glyph="&#xE706;" Style="{StaticResource CardIconStyle}" /><TextBlock Text="Dimmer" Style="{StaticResource SectionTitleStyle}" /></StackPanel>
                        <views:LevelFader Grid.Row="1" x:Name="DimmerSlider" HorizontalAlignment="Center" />
                        <StackPanel Grid.Row="2" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <Button Content="Off" Click="DimmerOff_Click" Padding="10,4" />
                                <Button Content="Full" Click="DimmerFull_Click" Padding="10,4" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Color -->
                <Border Style="{StaticResource CardStyle}" x:Name="ColorCard">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel>
                            <Grid>
                                <StackPanel Style="{StaticResource CardHeaderStyle}"><FontIcon Glyph="&#xE790;" Style="{StaticResource CardIconStyle}" /><TextBlock Text="Color" Style="{StaticResource SectionTitleStyle}" /></StackPanel>
                                <!-- The colour the selected lights have now -->
                                <Border Style="{StaticResource PillStyle}" HorizontalAlignment="Right" Margin="0,0,0,10" Padding="4,3,10,3">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse x:Name="ColorChip" Width="16" Height="16" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="1" />
                                        <TextBlock x:Name="ColorHex" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <!-- The picker has a large built-in size; the Viewbox scales it to fit so it never covers the quick colors. -->
                            <Viewbox Width="200" Height="200" Margin="0,6,0,0">
                                <ColorPicker x:Name="Picker" ColorSpectrumShape="Ring" IsAlphaEnabled="False"
                                             IsColorPreviewVisible="False" IsColorChannelTextInputVisible="False"
                                             IsHexInputVisible="False" IsMoreButtonVisible="False" IsColorSliderVisible="False"
                                             ColorChanged="Picker_ColorChanged" />
                            </Viewbox>
                        </StackPanel>
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Quick colors" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <VariableSizedWrapGrid x:Name="Swatches" Orientation="Horizontal" MaximumRowsOrColumns="3"
                                                   ItemWidth="40" ItemHeight="40" />
                            <TextBlock x:Name="WhiteLabel" Text="White LED" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,6,0,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Slider x:Name="WhiteSlider" Minimum="0" Maximum="255" Width="124" ValueChanged="WhiteSlider_ValueChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Position -->
                <Border Style="{StaticResource CardStyle}" x:Name="PositionCard">
                    <StackPanel Spacing="6">
                        <Grid>
                            <StackPanel Style="{StaticResource CardHeaderStyle}" ToolTipService.ToolTip="Keyboard: Shift+P, then the arrow keys"><FontIcon Glyph="&#xE81E;" Style="{StaticResource CardIconStyle}" /><TextBlock Text="Position" Style="{StaticResource SectionTitleStyle}" /></StackPanel>
                            <Button Content="Center" Click="CenterPosition_Click" HorizontalAlignment="Right" Padding="8,2" />
                        </Grid>
                        <Border x:Name="XYPad" Width="190" Height="190" CornerRadius="10" Background="{StaticResource LuxStageBrush}"
                                PointerPressed="XYPad_PointerPressed" PointerMoved="XYPad_PointerMoved"
                                PointerReleased="XYPad_PointerReleased">
                            <Canvas>
                                <!-- Quarter grid, centre lines, crosshair through the dot -->
                                <Line X1="47.5" Y1="0" X2="47.5" Y2="190" Stroke="#14FFFFFF" StrokeThickness="1" StrokeDashArray="2,3" />
                                <Line X1="142.5" Y1="0" X2="142.5" Y2="190" Stroke="#14FFFFFF" StrokeThickness="1" StrokeDashArray="2,3" />
                                <Line X1="0" Y1="47.5" X2="190" Y2="47.5" Stroke="#14FFFFFF" StrokeThickness="1" StrokeDashArray="2,3" />
                                <Line X1="0" Y1="142.5" X2="190" Y2="142.5" Stroke="#14FFFFFF" StrokeThickness="1" StrokeDashArray="2,3" />
                                <Line X1="95" Y1="0" X2="95" Y2="190" Stroke="#26FFFFFF" StrokeThickness="1" />
                                <Line X1="0" Y1="95" X2="190" Y2="95" Stroke="#26FFFFFF" StrokeThickness="1" />
                                <Line x:Name="XYCrossV" Y1="0" Y2="190" X1="95" X2="95" Stroke="{ThemeResource LuxAccentBrush}" StrokeThickness="1" Opacity="0.45" />
                                <Line x:Name="XYCrossH" X1="0" X2="190" Y1="95" Y2="95" Stroke="{ThemeResource LuxAccentBrush}" StrokeThickness="1" Opacity="0.45" />
                                <TextBlock Text="PAN" FontSize="9" Foreground="#66FFFFFF" Canvas.Left="6" Canvas.Top="176" CharacterSpacing="80" />
                                <TextBlock Text="TILT" FontSize="9" Foreground="#66FFFFFF" Canvas.Left="6" Canvas.Top="4" CharacterSpacing="80" />
                                <!-- Where the head really points while a movement runs -->
                                <Ellipse x:Name="XYLiveDot" Width="12" Height="12" Fill="#66FFFFFF" Visibility="Collapsed" IsHitTestVisible="False" />
                                <Ellipse x:Name="XYGlow" Width="34" Height="34" Fill="{ThemeResource LuxAccentBrush}" Opacity="0.25" IsHitTestVisible="False" Canvas.Left="78" Canvas.Top="78" />
                                <Ellipse x:Name="XYDot" Width="18" Height="18" Fill="{ThemeResource LuxAccentBrush}"
                                         Stroke="White" StrokeThickness="2" Canvas.Left="86" Canvas.Top="86" />
                            </Canvas>
                        </Border>
                        <TextBlock x:Name="PanTiltText" Text="Pan 50%  ·  Tilt 50%" HorizontalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>

                <!-- Movement effects for moving heads -->
                <Border Style="{StaticResource CardStyle}" x:Name="MovementCard" Width="470">
                    <Grid ColumnSpacing="14" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.ColumnSpan="2" Style="{StaticResource CardHeaderStyle}"><FontIcon Glyph="&#xE7AD;" Style="{StaticResource CardIconStyle}" /><TextBlock Text="Movement" Style="{StaticResource SectionTitleStyle}" /></StackPanel>

                        <StackPanel Grid.Row="1" Spacing="6">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ShapeBox" Header="Shape" HorizontalAlignment="Stretch" SelectionChanged="MoveChoice_Changed" />
                                <Button Grid.Column="1" Content="Shapes…" Click="Shapes_Click" VerticalAlignment="Bottom" Padding="8,5"
                                        ToolTipService.ToolTip="Draw, change, duplicate and name movement shapes" />
                            </Grid>
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="AreaBox" Header="Area" HorizontalAlignment="Stretch" SelectionChanged="MoveChoice_Changed"
                                          ToolTipService.ToolTip="Keep the movement inside an area such as the wall" />
                                <Button Grid.Column="1" Content="Areas…" Click="Areas_Click" VerticalAlignment="Bottom" Padding="8,5"
                                        ToolTipService.ToolTip="Set up areas such as Stage or Wall for each moving head" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                <Button Click="Movement_Click" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="Start movement">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="13" />
                                        <TextBlock Text="Start" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Stop" Click="StopMovement_Click" ToolTipService.ToolTip="Stop the movement on the selected lights" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Speed" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" x:Name="MoveSpeedSlider" Minimum="0.02" Maximum="2" StepFrequency="0.02" Value="0.25"
                                    ValueChanged="MoveParam_ValueChanged" />
                            <TextBlock Grid.Row="1" Text="Size" VerticalAlignment="Center" />
                            <Slider Grid.Row="1" Grid.Column="1" x:Name="MoveSizeSlider" Minimum="0" Maximum="1" StepFrequency="0.05" Value="0.5"
                                    ValueChanged="MoveParam_ValueChanged" />
                            <TextBlock Grid.Row="2" Text="Width" VerticalAlignment="Center" ToolTipService.ToolTip="How far it goes left/right (pan)" />
                            <Slider Grid.Row="2" Grid.Column="1" x:Name="MoveWidthSlider" Minimum="0" Maximum="1" StepFrequency="0.05" Value="1"
                                    ValueChanged="MoveParam_ValueChanged" />
                            <TextBlock Grid.Row="3" Text="Height" VerticalAlignment="Center" ToolTipService.ToolTip="How far it goes up/down (tilt)" />
                            <Slider Grid.Row="3" Grid.Column="1" x:Name="MoveHeightSlider" Minimum="0" Maximum="1" StepFrequency="0.05" Value="1"
                                    ValueChanged="MoveParam_ValueChanged" />
                            <TextBlock Grid.Row="4" Text="Spread" VerticalAlignment="Center"
                                       ToolTipService.ToolTip="0 = all heads move together; higher = each head a bit later, across the stage" />
                            <Slider Grid.Row="4" Grid.Column="1" x:Name="MoveSpreadSlider" Minimum="0" Maximum="1" StepFrequency="0.05" Value="0"
                                    ValueChanged="MoveParam_ValueChanged" />
                            <CheckBox Grid.Row="5" Grid.ColumnSpan="2" x:Name="MoveReverseBox" Content="Reverse direction" Click="MoveSetting_Changed" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Effects -->
                <Border Style="{StaticResource CardStyle}" Width="300">
                    <StackPanel Spacing="6">
                        <StackPanel Style="{StaticResource CardHeaderStyle}"><FontIcon Glyph="&#xE734;" Style="{StaticResource CardIconStyle}" /><TextBlock Text="Effects" Style="{StaticResource SectionTitleStyle}" /></StackPanel>
                        <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" ItemWidth="134" ItemHeight="40">
                            <Button Tag="Rainbow" Click="Effect_Click" Style="{StaticResource ToolButtonStyle}" AutomationProperties.Name="Rainbow"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE790;" FontSize="14" /><TextBlock Text="Rainbow" /></StackPanel></Button>
                            <Button Tag="Chase" Click="Effect_Click" Style="{StaticResource ToolButtonStyle}" AutomationProperties.Name="Chase"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72A;" FontSize="14" /><TextBlock Text="Chase" /></StackPanel></Button>
                            <Button Tag="Wave" Click="Effect_Click" Style="{StaticResource ToolButtonStyle}" AutomationProperties.Name="Wave"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE895;" FontSize="14" /><TextBlock Text="Wave" /></StackPanel></Button>
                            <Button Tag="Strobe" Click="Effect_Click" Style="{StaticResource ToolButtonStyle}" AutomationProperties.Name="Strobe"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE945;" FontSize="14" /><TextBlock Text="Strobe" /></StackPanel></Button>
                            <Button Click="StopEffects_Click" Style="{StaticResource ToolButtonStyle}" AutomationProperties.Name="Stop all" ToolTipService.ToolTip="Stop every effect on the selected lights, including movement"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE71A;" FontSize="14" /><TextBlock Text="Stop all" /></StackPanel></Button>
                        </VariableSizedWrapGrid>
                        <Grid ColumnSpacing="8" RowSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Speed" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" x:Name="SpeedSlider" Minimum="0.05" Maximum="5" StepFrequency="0.05" Value="0.5"
                                    ValueChanged="EffectParam_ValueChanged" />
                            <TextBlock Grid.Row="1" Text="Size" VerticalAlignment="Center" />
                            <Slider Grid.Row="1" Grid.Column="1" x:Name="SizeSlider" Minimum="0" Maximum="1" StepFrequency="0.05" Value="1"
                                    ValueChanged="EffectParam_ValueChanged" />
                            <TextBlock Grid.Row="2" Text="Spread" VerticalAlignment="Center" />
                            <Slider Grid.Row="2" Grid.Column="1" x:Name="SpreadSlider" Minimum="0" Maximum="1" StepFrequency="0.05" Value="1"
                                    ValueChanged="EffectParam_ValueChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sound to light -->
                <Border Style="{StaticResource CardStyle}" Width="220">
                    <StackPanel Spacing="8">
                        <StackPanel Style="{StaticResource CardHeaderStyle}"><FontIcon Glyph="&#xE767;" Style="{StaticResource CardIconStyle}" /><TextBlock Text="Sound to light" Style="{StaticResource SectionTitleStyle}" /></StackPanel>
                        <ToggleSwitch x:Name="SoundSwitch" OnContent="Listening" OffContent="Off" Toggled="SoundSwitch_Toggled" />
                        <ComboBox x:Name="SoundSource" HorizontalAlignment="Stretch" SelectionChanged="SoundSource_SelectionChanged">
                            <ComboBoxItem Content="Music playing on this PC" Tag="SystemSound" />
                            <ComboBoxItem Content="Microphone / line in" Tag="Microphone" />
                        </ComboBox>
                        <TextBlock Text="Strength" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Slider x:Name="SoundAmount" Minimum="0" Maximum="1" StepFrequency="0.05" Value="0.8"
                                ValueChanged="SoundAmount_ValueChanged" />
                        <ProgressBar x:Name="SoundMeter" Minimum="0" Maximum="1" Height="6" />
                    </StackPanel>
                </Border>

                <!-- Other channels (built in code) -->
                <Border Style="{StaticResource CardStyle}" x:Name="ChannelsCard" MinWidth="260">
                    <StackPanel Spacing="6">
                        <StackPanel Style="{StaticResource CardHeaderStyle}"><FontIcon Glyph="&#xE713;" Style="{StaticResource CardIconStyle}" /><TextBlock Text="More controls" Style="{StaticResource SectionTitleStyle}" /></StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250">
                            <StackPanel x:Name="ChannelRows" Spacing="2" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </helpers:WrapPanel>
        </ScrollViewer>

        <!-- Shown when nothing is selected -->
        <Border Grid.Row="2" x:Name="NothingSelected" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.92"
                CornerRadius="8" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE8B0;" FontSize="30" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Select lights to control them" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Click fixtures in the list on the left or on the stage. Drag across the stage to select several."
                           HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
