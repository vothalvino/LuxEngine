<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LuxEngine.App.Views.ControlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="8" Padding="12,10,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Shown while a preset is being edited -->
        <Border Grid.Row="0" x:Name="PresetEditBar" Visibility="Collapsed" CornerRadius="8" Padding="12,8"
                Background="{StaticResource LuxAccentBrush}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="#1B1B1B" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PresetEditTitle" Foreground="#1B1B1B" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PresetEditInfo" Foreground="#1B1B1B" Opacity="0.85" TextTrimming="CharacterEllipsis"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Click="PresetEditCancel_Click" Content="Cancel" />
                    <Button Click="PresetEditSave_Click" AutomationProperties.Name="Save preset changes">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock Text="Save changes" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Selection summary and actions -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="Clear_Click" ToolTipService.ToolTip="Forget all manual changes and go back to what the cues are doing">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE894;" FontSize="14" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>
                <Button Click="SavePreset_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="Save as preset" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Cards" Orientation="Horizontal" Spacing="10">

                <!-- Dimmer -->
                <Border Style="{StaticResource CardStyle}" Width="120">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Dimmer" Style="{StaticResource SectionTitleStyle}" />
                        <Slider Grid.Row="1" x:Name="DimmerSlider" Orientation="Vertical" Minimum="0" Maximum="100"
                                HorizontalAlignment="Center" ValueChanged="DimmerSlider_ValueChanged" MinHeight="140" />
                        <StackPanel Grid.Row="2" Spacing="4">
                            <TextBlock x:Name="DimmerText" Text="0%" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <Button Content="Off" Click="DimmerOff_Click" Padding="10,4" />
                                <Button Content="Full" Click="DimmerFull_Click" Padding="10,4" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Color -->
                <Border Style="{StaticResource CardStyle}" x:Name="ColorCard">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel>
                            <TextBlock Text="Color" Style="{StaticResource SectionTitleStyle}" />
                            <ColorPicker x:Name="Picker" ColorSpectrumShape="Ring" IsAlphaEnabled="False"
                                         IsColorPreviewVisible="False" IsColorChannelTextInputVisible="False"
                                         IsHexInputVisible="False" IsMoreButtonVisible="False" IsColorSliderVisible="False"
                                         ColorChanged="Picker_ColorChanged" Width="210" />
                        </StackPanel>
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Quick colors" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <VariableSizedWrapGrid x:Name="Swatches" Orientation="Horizontal" MaximumRowsOrColumns="3"
                                                   ItemWidth="40" ItemHeight="40" />
                            <TextBlock x:Name="WhiteLabel" Text="White" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,6,0,0" />
                            <Slider x:Name="WhiteSlider" Minimum="0" Maximum="255" Width="120" ValueChanged="WhiteSlider_ValueChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Position -->
                <Border Style="{StaticResource CardStyle}" x:Name="PositionCard">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="Position" Style="{StaticResource SectionTitleStyle}" />
                            <Button Content="Center" Click="CenterPosition_Click" HorizontalAlignment="Right" Padding="8,2" />
                        </Grid>
                        <Border x:Name="XYPad" Width="190" Height="190" CornerRadius="6" Background="{StaticResource LuxStageBrush}"
                                PointerPressed="XYPad_PointerPressed" PointerMoved="XYPad_PointerMoved"
                                PointerReleased="XYPad_PointerReleased">
                            <Canvas>
                                <Line X1="95" Y1="0" X2="95" Y2="190" Stroke="#33FFFFFF" StrokeThickness="1" />
                                <Line X1="0" Y1="95" X2="190" Y2="95" Stroke="#33FFFFFF" StrokeThickness="1" />
                                <Ellipse x:Name="XYDot" Width="18" Height="18" Fill="{StaticResource LuxAccentBrush}"
                                         Stroke="White" StrokeThickness="2" Canvas.Left="86" Canvas.Top="86" />
                            </Canvas>
                        </Border>
                        <TextBlock x:Name="PanTiltText" Text="Pan 50%  ·  Tilt 50%" HorizontalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>

                <!-- Effects -->
                <Border Style="{StaticResource CardStyle}" Width="300">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Effects" Style="{StaticResource SectionTitleStyle}" />
                        <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="92" ItemHeight="38">
                            <Button Content="🌈 Rainbow" Tag="Rainbow" Click="Effect_Click" HorizontalAlignment="Stretch" Margin="2" />
                            <Button Content="➡ Chase" Tag="Chase" Click="Effect_Click" HorizontalAlignment="Stretch" Margin="2" />
                            <Button Content="〰 Wave" Tag="Wave" Click="Effect_Click" HorizontalAlignment="Stretch" Margin="2" />
                            <Button Content="⚡ Strobe" Tag="Strobe" Click="Effect_Click" HorizontalAlignment="Stretch" Margin="2" />
                            <Button Content="⭕ Circle" Tag="Circle" Click="Effect_Click" HorizontalAlignment="Stretch" Margin="2" />
                            <Button Content="Stop" Click="StopEffects_Click" HorizontalAlignment="Stretch" Margin="2" />
                        </VariableSizedWrapGrid>
                        <Grid ColumnSpacing="8" RowSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Speed" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" x:Name="SpeedSlider" Minimum="0.05" Maximum="5" StepFrequency="0.05" Value="0.5"
                                    ValueChanged="EffectParam_ValueChanged" />
                            <TextBlock Grid.Row="1" Text="Size" VerticalAlignment="Center" />
                            <Slider Grid.Row="1" Grid.Column="1" x:Name="SizeSlider" Minimum="0" Maximum="1" StepFrequency="0.05" Value="1"
                                    ValueChanged="EffectParam_ValueChanged" />
                            <TextBlock Grid.Row="2" Text="Spread" VerticalAlignment="Center" />
                            <Slider Grid.Row="2" Grid.Column="1" x:Name="SpreadSlider" Minimum="0" Maximum="1" StepFrequency="0.05" Value="1"
                                    ValueChanged="EffectParam_ValueChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sound to light -->
                <Border Style="{StaticResource CardStyle}" Width="220">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Sound to light" Style="{StaticResource SectionTitleStyle}" />
                        <ToggleSwitch x:Name="SoundSwitch" OnContent="Listening" OffContent="Off" Toggled="SoundSwitch_Toggled" />
                        <ComboBox x:Name="SoundSource" HorizontalAlignment="Stretch" SelectionChanged="SoundSource_SelectionChanged">
                            <ComboBoxItem Content="Music playing on this PC" Tag="SystemSound" />
                            <ComboBoxItem Content="Microphone / line in" Tag="Microphone" />
                        </ComboBox>
                        <TextBlock Text="Strength" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Slider x:Name="SoundAmount" Minimum="0" Maximum="1" StepFrequency="0.05" Value="0.8"
                                ValueChanged="SoundAmount_ValueChanged" />
                        <ProgressBar x:Name="SoundMeter" Minimum="0" Maximum="1" Height="6" />
                    </StackPanel>
                </Border>

                <!-- Other channels (built in code) -->
                <Border Style="{StaticResource CardStyle}" x:Name="ChannelsCard" MinWidth="260">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Beam &amp; more" Style="{StaticResource SectionTitleStyle}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250">
                            <StackPanel x:Name="ChannelRows" Spacing="2" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Shown when nothing is selected -->
        <Border Grid.Row="2" x:Name="NothingSelected" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.92"
                CornerRadius="8" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE8B0;" FontSize="30" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Select lights to control them" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Click fixtures in the list on the left or on the stage. Drag across the stage to select several."
                           HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
