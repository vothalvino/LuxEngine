<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LuxEngine.App.Views.StageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="StageRoot" CornerRadius="8" Background="{StaticResource LuxStageBrush}"
          PointerPressed="Stage_PointerPressed" PointerMoved="Stage_PointerMoved"
          PointerReleased="Stage_PointerReleased" PointerCanceled="Stage_PointerReleased"
          SizeChanged="Stage_SizeChanged">

        <!-- Stage floor hint -->
        <Border VerticalAlignment="Bottom" Height="36" Margin="40,0,40,10" CornerRadius="6"
                BorderBrush="#33FFFFFF" BorderThickness="1" IsHitTestVisible="False">
            <TextBlock Text="AUDIENCE" Foreground="#55FFFFFF" FontSize="11" CharacterSpacing="300"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <Canvas x:Name="StageCanvas" />

        <Rectangle x:Name="SelectionRect" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Stroke="{ThemeResource LuxAccentBrush}" StrokeThickness="1" Fill="#22FFB938" IsHitTestVisible="False" />

        <TextBlock Text="STAGE" Foreground="#88FFFFFF" FontSize="12" CharacterSpacing="200" Margin="14,10"
                   HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />

        <StackPanel Orientation="Horizontal" Spacing="6" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top">
            <ToggleButton x:Name="ArrangeButton" ToolTipService.ToolTip="Drag fixtures to where they hang on your stage">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE7C2;" FontSize="14" />
                    <TextBlock Text="Arrange" />
                </StackPanel>
            </ToggleButton>
            <Button Click="AutoArrange_Click" ToolTipService.ToolTip="Line fixtures up by type">
                <FontIcon Glyph="&#xE8A9;" FontSize="14" />
            </Button>
        </StackPanel>

        <TextBlock x:Name="EmptyText" Text="Your lights will appear here once you add fixtures."
                   Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>
</UserControl>
